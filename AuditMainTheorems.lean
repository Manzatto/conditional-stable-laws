    ("F(ii)", #[``ConditionedStableLaws.RefinedLLN.lln_L1,
      ``ConditionedStableLaws.RefinedLLN.lln_mean_nonneg,
      ``ConditionedStableLaws.KernelMaximal.measure_maximal_kernel_sum,
      ``ConditionedStableLaws.KernelCesaro.tendsto_ae_nonneg_kernel_sum,
      ``ConditionedStableLaws.QProcessCesaro.nonneg_kernel_cesaro]),
    ("F(iii)", #[``ConditionedStableLaws.RefinedLLN.lln_probability,
      ``ConditionedStableLaws.QProcessIntegrable.lln_mean,
      ``ConditionedStableLaws.QProcessEndpoint.inverseWeight_uniformly_integrable,
      ``ConditionedStableLaws.KilledLiveTransfer.transfer_average,
      ``ConditionedStableLaws.ConditionalTransfer.conditional_transfer])]
  for (label, names) in results do
    for name in names do
      let axioms ← collectAxioms name
      for ax in axioms do
        unless standard.contains ax do
          throwError "Main result {label}: {name} depends on nonstandard axiom {ax}"
    logInfo m!"Main result {label}: {names.size} mapped declarations, no cited axiom."
