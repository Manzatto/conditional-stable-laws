      ``ConditionedStableLaws.GaussianBoundary.stable_law_boundary,
      ``ConditionedStableLaws.StableScaling.isStableLaw_of_powerLevyExponent]),
    ("C", #[``ConditionedStableLaws.L2Variance.conditional_clt_l2,
      ``ConditionedStableLaws.L2Variance.large_observation_tendsto_zero,
      ``ConditionedStableLaws.L2Variance.large_observation_sum_le,
      ``ConditionedStableLaws.L2Variance.truncation_negligible_of_large_observations,
      ``ConditionedStableLaws.L2Variance.summable_abs_correlation_l2,
      ``ConditionedStableLaws.L2Variance.asymptoticVariance_truncation_tendsto,
      ``ConditionedStableLaws.L2Variance.conditional_clt_l2_of_truncation_negligible]),
    ("D", #[``ConditionedStableLaws.Concentration.conditional_exponential_concentration_sq,
      ``ConditionedStableLaws.Concentration.conditional_exponential_concentration,
      ``ConditionedStableLaws.Concentration.integral_conditioned_exp,
