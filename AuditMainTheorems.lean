import ConditionedStableLaws
import Lean.Util.CollectAxioms

open Lean Elab Command in
run_cmd do
  let standard := #[``propext, ``Classical.choice, ``Quot.sound]
  let results : Array (String × Array Name) := #[
    ("Public A–F", #[``ConditionedStableLaws.TheoremA,
      ``ConditionedStableLaws.TheoremB,
      ``ConditionedStableLaws.TheoremC,
      ``ConditionedStableLaws.TheoremD,
      ``ConditionedStableLaws.TheoremE,
      ``ConditionedStableLaws.TheoremF]),
    ("Public components", #[``ConditionedStableLaws.TheoremA.pointProcess,
      ``ConditionedStableLaws.TheoremA.intervalCounts,
      ``ConditionedStableLaws.TheoremA.poissonLaw,
      ``ConditionedStableLaws.TheoremB.part_i,
      ``ConditionedStableLaws.TheoremB.part_ii,
      ``ConditionedStableLaws.TheoremB.part_iii,
      ``ConditionedStableLaws.TheoremB.part_iv,
      ``ConditionedStableLaws.TheoremB.laplace_i,
      ``ConditionedStableLaws.TheoremB.characteristic_ii,
      ``ConditionedStableLaws.TheoremB.characteristic_iii,
      ``ConditionedStableLaws.TheoremB.stable_i,
      ``ConditionedStableLaws.TheoremB.stable_ii,
      ``ConditionedStableLaws.TheoremB.stable_iii,
      ``ConditionedStableLaws.TheoremD.explicitRate,
      ``ConditionedStableLaws.TheoremF.part_i,
      ``ConditionedStableLaws.TheoremF.part_ii,
      ``ConditionedStableLaws.TheoremF.part_iii]),
    ("A", #[``ConditionedStableLaws.path_empirical_poisson_process_convergence_of_trimmed_estimates,
      ``ConditionedStableLaws.CanonicalChain.poisson_point_process_of_admissibility,
      ``ConditionedStableLaws.CanonicalChain.poisson_interval_counts_of_admissibility,
      ``ConditionedStableLaws.power_poisson_limit_isPoissonRandomMeasure]),
    ("B", #[``ConditionedStableLaws.StableLawSmall.stable_law_small,
      ``ConditionedStableLaws.StableLawCompensated.stable_law_one,
      ``ConditionedStableLaws.StableLawCompensated.stable_law_mid,
      ``ConditionedStableLaws.StableLawCompensated.stable_law_of_compensation,
      ``ConditionedStableLaws.CompensatedPoissonLimits.cut_unitCompensated_tendstoInDistribution,
      ``ConditionedStableLaws.CompensatedPoissonLimits.cut_fullyCompensated_tendstoInDistribution,
      ``ConditionedStableLaws.CompensationAsymptotics.scaled_band_mean,
      ``ConditionedStableLaws.CompensationAsymptotics.scaled_tail_mean,
      ``ConditionedStableLaws.AnnularPoissonClouds.positiveIntegral_laplace,
      ``ConditionedStableLaws.AnnularPoissonClouds.total_mark_finite,
      ``ConditionedStableLaws.powerIntensity_small_moment,
      ``ConditionedStableLaws.powerIntensity_large_moment,
      ``ConditionedStableLaws.AnnularPoissonClouds.compensatedIntegral_characteristic,
      ``ConditionedStableLaws.AnnularPoissonClouds.compensatedSmallJumps_second_moment,
      ``ConditionedStableLaws.AnnularPoissonClouds.compensatedSmallJumps_tendstoInMeasure,
      ``ConditionedStableLaws.AnnularPoissonClouds.unitCompensatedStable_characteristic_real,
      ``ConditionedStableLaws.AnnularPoissonClouds.fullyCompensatedStable_characteristic_real,
      ``ConditionedStableLaws.AnnularPoissonClouds.unitCutoff_eq_setIntegrals,
      ``ConditionedStableLaws.AnnularPoissonClouds.unitCutoff_tendstoInMeasure,
      ``ConditionedStableLaws.AnnularPoissonClouds.fullCutoff_eq_setIntegrals,
      ``ConditionedStableLaws.AnnularPoissonClouds.fullCutoff_tendstoInMeasure,
      ``ConditionedStableLaws.StableIdentification.positiveIntegral_isStable,
      ``ConditionedStableLaws.StableIdentification.positiveIntegral_ae_eq,
      ``ConditionedStableLaws.StableIdentification.unitCompensatedStable_isStable,
